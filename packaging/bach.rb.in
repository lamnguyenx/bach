# Generated by make dist from the exact release archive.
# Publish as Formula/bach.rb in your homebrew-tap repository.
class Bach < Formula
  desc "Modular Bash configuration toolkit"
  homepage "https://github.com/@REPOSITORY@"
  url "https://github.com/@REPOSITORY@/releases/download/v@VERSION@/bach-@VERSION@.tar.gz"
  version "@VERSION@"
  sha256 "@SHA256@"

  def install
    system "make", "install", "PREFIX=#{prefix}"
  end

  def caveats
    <<~EOS
      Activate Bach in Bash:
        bach init --write
      On macOS, ensure your Bash login profile sources ~/.bashrc.
      Before removal, run bach deinit to remove the activation block.
    EOS
  end

  test do
    assert_equal version.to_s, shell_output("#{bin}/bach --version").strip
    assert_match "bach initialize", shell_output("#{bin}/bach init")
  end
end
